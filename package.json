    "dexie": "^4.4.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "fake-indexeddb": "^6.2.5",
    "http-proxy-middleware": "^4.2.0",
    "i18next": "^26.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
