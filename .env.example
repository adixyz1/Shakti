# SAATHI Environment Configuration
# Copy this file to .env for local development. Never commit real secrets.

# Runtime Environment (development | test | production)
ENVIRONMENT="development"
PORT=3000

# Database Configuration (SQLite via Drizzle ORM + @libsql/client)
DATABASE_URL="file:./saathi.db"

# Security & JWT (Change in production)
JWT_SECRET_KEY="saathi-dev-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Policy
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3
AUTH_RATE_LIMIT_PER_MINUTE=10

# CORS & Web URLs
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
VITE_API_BASE_URL="/api"
APP_URL="http://localhost:3000"

# Optional AI Assist (Strictly OFF by default per Constraint #6)
ENABLE_AI_ASSIST="false"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Android APK Download & PWABuilder Trusted Web Activity (TWA)
VITE_ANDROID_APK_URL="/shakti.apk"
ANDROID_TWA_PACKAGE_NAME="app.shakti.safety.twa"
ANDROID_TWA_SHA256_FINGERPRINT=""

