# SAATHI / SHAKTI Environment Configuration
# Copy this file to .env for local development or Oracle Cloud deployment. Never commit real secrets.

# Runtime Environment (development | staging | test | production)
# Note: Use NODE_ENV="staging" when DEMO_MODE="true" on hosted demos; use NODE_ENV="production" with DEMO_MODE="false" for production.
NODE_ENV="development"
ENVIRONMENT="development"
PORT=3000

# Caddy HTTPS Domain (e.g. 129.154.x.x.nip.io or yourname.duckdns.org)
SHAKTI_DOMAIN="localhost"

# Reverse Proxy & Cookie Security (Set both to true/1 behind Caddy HTTPS)
TRUST_PROXY=1
COOKIE_SECURE="false"
DEMO_MODE="true"
ALLOW_MOCK_PROVIDERS="true"

# Database Configuration (SQLite via Drizzle ORM + @libsql/client)
DATABASE_URL="file:./saathi.db"

# Security, JWT & HMAC (Generate 48-byte hex secrets in production/staging via: openssl rand -hex 48)
JWT_SECRET_KEY="saathi-dev-secret-key-change-in-production"
HMAC_SECRET_KEY="saathi-dev-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Policy
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3
AUTH_RATE_LIMIT_PER_MINUTE=10

# CORS & Web URLs
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
VITE_API_BASE_URL="/api"
VITE_REMOTE_SERVER_URL=""
APP_URL="http://localhost:3000"

# Optional AI Assist (Strictly OFF by default)
ENABLE_AI_ASSIST="false"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Android APK Download & PWABuilder Trusted Web Activity (TWA)
VITE_ANDROID_APK_URL="/shakti.apk"
ANDROID_TWA_PACKAGE_NAME="app.shakti.safety.twa"
ANDROID_TWA_SHA256_FINGERPRINT=""


